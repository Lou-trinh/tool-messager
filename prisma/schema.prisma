generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  ZALO
  FACEBOOK
  TIKTOK
}

enum AccountStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
  ERROR
  REAUTH_REQUIRED
  LIMITED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum ContactStatus {
  ACTIVE
  ARCHIVED
  DO_NOT_CONTACT
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  BLOCKED
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHED
  FAILED
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum JobStatus {
  PENDING
  RUNNING
  RETRYING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProxyStatus {
  HEALTHY
  UNHEALTHY
  UNKNOWN
  DISABLED
}

enum ProxyType {
  HTTP
  HTTPS
  SOCKS5
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WEBHOOK
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SystemRole {
  SUPER_ADMIN
  USER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum PlanCode {
  FREE
  BASIC
  PRO
  BUSINESS
  ENTERPRISE
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum UsageMetric {
  MESSAGES
  CONTACTS
  ACCOUNTS
  CAMPAIGNS
  STORAGE_BYTES
  API_CALLS
}

enum SuppressionScope {
  GLOBAL
  TENANT
}

enum SupportSessionStatus {
  ACTIVE
  ENDED
  REVOKED
  EXPIRED
}

model User {
  id                  String                   @id @default(cuid())
  email               String                   @unique
  passwordHash        String
  displayName         String
  emailVerifiedAt     DateTime?
  twoFactorEnabled    Boolean                  @default(false)
  twoFactorSecretEnc  String?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  deletedAt           DateTime?
  systemRole          SystemRole               @default(USER)
  memberships         WorkspaceMember[]
  refreshTokens       RefreshToken[]
  verificationTokens  EmailVerificationToken[]
  auditLogs           AuditLog[]
  assignedTasks       Task[]
  notifications       Notification[]
  invitationsSent     WorkspaceInvitation[]    @relation("InvitationSender")
  platformOAuthStates PlatformOAuthState[]
  supportSessions     SupportSession[]         @relation("SupportAdmin")
}

model Workspace {
  id                  String                @id @default(cuid())
  name                String
  slug                String                @unique
  timezone            String                @default("Asia/Ho_Chi_Minh")
  status              TenantStatus          @default(ACTIVE)
  suspendedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?
  members             WorkspaceMember[]
  invitations         WorkspaceInvitation[]
  roles               Role[]
  accounts            SocialAccount[]
  contacts            Contact[]
  tags                Tag[]
  groups              Group[]
  conversations       Conversation[]
  messages            Message[]
  messageEvents       MessageEvent[]
  templates           MessageTemplate[]
  mediaAssets         MediaAsset[]
  campaigns           Campaign[]
  posts               Post[]
  automations         Automation[]
  proxies             Proxy[]
  syncJobs            SyncJob[]
  backgroundJobs      BackgroundJob[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  webhookEvents       WebhookEvent[]
  tasks               Task[]
  platformOAuthStates PlatformOAuthState[]
  subscriptions       Subscription[]
  usageCounters       UsageCounter[]
  invoices            Invoice[]
  suppressions        SuppressionEntry[]
  supportSessions     SupportSession[]

  @@index([deletedAt])
}

model Plan {
  id                  String         @id @default(cuid())
  code                PlanCode       @unique
  name                String
  description         String?
  monthlyPriceCents   Int            @default(0)
  maxZaloAccounts     Int
  maxUsers            Int
  maxContacts         Int
  maxCampaigns        Int
  maxMessagesPerDay   Int
  maxMessagesPerMonth Int
  maxStorageBytes     BigInt
  automationEnabled   Boolean        @default(false)
  analyticsEnabled    Boolean        @default(false)
  apiEnabled          Boolean        @default(false)
  active              Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  subscriptions       Subscription[]
  invoices            Invoice[]
}

model Subscription {
  id          String             @id @default(cuid())
  workspaceId String
  planId      String
  startAt     DateTime
  endAt       DateTime
  status      SubscriptionStatus @default(ACTIVE)
  autoRenew   Boolean            @default(false)
  overrides   Json               @default("{}")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan        Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices    Invoice[]

  @@index([workspaceId, status, endAt])
}

model UsageCounter {
  id          String      @id @default(cuid())
  workspaceId String
  metric      UsageMetric
  periodStart DateTime
  periodEnd   DateTime
  value       BigInt      @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, metric, periodStart, periodEnd])
  @@index([workspaceId, metric, periodEnd])
}

model Invoice {
  id             String        @id @default(cuid())
  workspaceId    String
  subscriptionId String?
  planId         String?
  number         String        @unique
  status         InvoiceStatus @default(DRAFT)
  amountCents    Int
  currency       String        @default("VND")
  dueAt          DateTime?
  paidAt         DateTime?
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan           Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
}

model SuppressionEntry {
  id              String           @id @default(cuid())
  workspaceId     String?
  scope           SuppressionScope
  platform        Platform?
  platformUserId  String?
  normalizedPhone String?
  reason          String
  source          String
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workspace       Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, normalizedPhone])
  @@index([workspaceId, platform, platformUserId])
}

model SupportSession {
  id          String               @id @default(cuid())
  adminId     String
  workspaceId String
  reason      String
  status      SupportSessionStatus @default(ACTIVE)
  startedAt   DateTime             @default(now())
  expiresAt   DateTime
  endedAt     DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  admin       User                 @relation("SupportAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([adminId, status, expiresAt])
  @@index([workspaceId, status])
}

model SystemControl {
  id             String   @id
  outboundPaused Boolean  @default(false)
  reason         String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(VIEWER)
  status      MemberStatus  @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole
  tokenHash   String        @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User          @relation("InvitationSender", fields: [invitedById], references: [id])

  @@unique([workspaceId, email])
}

model Role {
  id          String           @id @default(cuid())
  workspaceId String?
  key         String
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions RolePermission[]

  @@unique([workspaceId, key])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id              String         @id @default(cuid())
  userId          String
  familyId        String
  parentId        String?        @unique
  tokenHash       String         @unique
  sessionName     String?
  ipHash          String?
  userAgent       String?
  expiresAt       DateTime
  revokedAt       DateTime?
  reuseDetectedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent          RefreshToken?  @relation("RefreshTokenRotation", fields: [parentId], references: [id], onDelete: SetNull)
  replacement     RefreshToken?  @relation("RefreshTokenRotation")

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model SocialAccount {
  id                String              @id @default(cuid())
  workspaceId       String
  platform          Platform
  platformAccountId String
  username          String?
  displayName       String
  avatarUrl         String?
  status            AccountStatus       @default(DISCONNECTED)
  permissions       Json                @default("[]")
  tokenExpiresAt    DateTime?
  lastSyncAt        DateTime?
  lastErrorCode     String?
  metadata          Json                @default("{}")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credential        PlatformCredential?
  friends           Friend[]
  conversations     Conversation[]
  messages          Message[]
  campaigns         Campaign[]
  posts             Post[]
  groups            Group[]
  accountProxies    AccountProxy[]
  syncJobs          SyncJob[]

  @@unique([workspaceId, platform, platformAccountId])
  @@index([workspaceId, status])
  @@index([deletedAt])
}

model PlatformCredential {
  id                    String        @id @default(cuid())
  accountId             String        @unique
  encryptedAccessToken  String
  encryptedRefreshToken String?
  tokenVersion          Int           @default(1)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  account               SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model PlatformOAuthState {
  id                    String    @id @default(cuid())
  platform              Platform
  stateHash             String    @unique
  encryptedCodeVerifier String
  redirectUri           String
  workspaceId           String
  userId                String
  expiresAt             DateTime
  usedAt                DateTime?
  createdAt             DateTime  @default(now())
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt, usedAt])
  @@index([workspaceId, platform])
}

model Contact {
  id                String             @id @default(cuid())
  workspaceId       String
  platform          Platform
  platformUserId    String?
  displayName       String
  username          String?
  phone             String?
  normalizedPhone   String?
  email             String?
  avatarUrl         String?
  gender            String?
  birthday          DateTime?
  source            String?
  notes             String?
  status            ContactStatus      @default(ACTIVE)
  consentStatus     ConsentStatus      @default(UNKNOWN)
  suppressed        Boolean            @default(false)
  lastInteractionAt DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tags              ContactTag[]
  consents          ContactConsent[]
  friendships       Friend[]
  groupMemberships  GroupMember[]
  conversations     Conversation[]
  campaignAudience  CampaignAudience[]
  campaignMessages  CampaignMessage[]

  @@unique([workspaceId, platform, platformUserId])
  @@index([workspaceId, normalizedPhone])
  @@index([workspaceId, consentStatus, suppressed])
  @@index([deletedAt])
}

model Tag {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  color       String       @default("#64748b")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts    ContactTag[]

  @@unique([workspaceId, name])
}

model ContactTag {
  contactId String
  tagId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model ContactConsent {
  id         String        @id @default(cuid())
  contactId  String
  status     ConsentStatus
  source     String
  legalBasis String?
  proof      Json          @default("{}")
  consentAt  DateTime?
  optOutAt   DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  contact    Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
}

model Friend {
  id          String        @id @default(cuid())
  accountId   String
  contactId   String
  status      String        @default("ACTIVE")
  connectedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact     Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([accountId, contactId])
}

model Group {
  id              String         @id @default(cuid())
  workspaceId     String
  accountId       String?
  platform        Platform
  platformGroupId String
  name            String
  avatarUrl       String?
  memberCount     Int            @default(0)
  isAdmin         Boolean        @default(false)
  status          String         @default("ACTIVE")
  lastSyncAt      DateTime?
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account         SocialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  members         GroupMember[]

  @@unique([workspaceId, platform, platformGroupId])
  @@index([workspaceId, platform])
}

model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  contactId String
  role      String    @default("MEMBER")
  status    String    @default("ACTIVE")
  joinedAt  DateTime?
  removedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([groupId, contactId])
}

model Conversation {
  id                     String        @id @default(cuid())
  workspaceId            String
  accountId              String
  contactId              String?
  platformConversationId String
  title                  String?
  status                 String        @default("OPEN")
  lastMessageAt          DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  workspace              Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account                SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact                Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages               Message[]

  @@unique([accountId, platformConversationId])
  @@index([workspaceId, lastMessageAt])
}

model Message {
  id                String              @id @default(cuid())
  workspaceId       String
  conversationId    String
  accountId         String
  platform          Platform
  platformMessageId String?
  idempotencyKey    String              @unique
  senderId          String
  receiverId        String
  content           String
  messageType       String              @default("TEXT")
  direction         MessageDirection
  status            MessageStatus       @default(QUEUED)
  timestamp         DateTime            @default(now())
  errorCode         String?
  metadata          Json                @default("{}")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation      Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  account           SocialAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  attachments       MessageAttachment[]
  campaignMessage   CampaignMessage?
  events            MessageEvent[]

  @@index([workspaceId, status, timestamp])
  @@index([platformMessageId])
}

model MessageEvent {
  id          String    @id @default(cuid())
  workspaceId String
  messageId   String
  type        String
  payload     Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([workspaceId, messageId, createdAt])
}

model MessageAttachment {
  id           String      @id @default(cuid())
  messageId    String
  mediaAssetId String?
  url          String
  type         MediaType
  metadata     Json        @default("{}")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  message      Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
}

model MessageTemplate {
  id          String     @id @default(cuid())
  workspaceId String
  name        String
  type        String     @default("TEXT")
  content     String
  variables   Json       @default("[]")
  version     Int        @default(1)
  status      String     @default("ACTIVE")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]

  @@unique([workspaceId, name, version])
}

model MediaAsset {
  id          String              @id @default(cuid())
  workspaceId String
  objectKey   String              @unique
  name        String
  mediaType   MediaType
  mimeType    String
  size        BigInt
  checksum    String
  folder      String?
  metadata    Json                @default("{}")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  attachments MessageAttachment[]
  postMedia   PostMedia[]

  @@index([workspaceId, mediaType])
}

model Campaign {
  id                 String             @id @default(cuid())
  workspaceId        String
  accountId          String?
  templateId         String?
  name               String
  platform           Platform
  audienceDefinition Json               @default("{}")
  promotional        Boolean            @default(true)
  scheduledAt        DateTime?
  endAt              DateTime?
  timezone           String             @default("Asia/Ho_Chi_Minh")
  scheduleMode       String             @default("ONE_TIME")
  status             CampaignStatus     @default(DRAFT)
  statistics         Json               @default("{}")
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account            SocialAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  template           MessageTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  audience           CampaignAudience[]
  messages           CampaignMessage[]

  @@index([workspaceId, status, scheduledAt])
}

model CampaignAudience {
  id             String   @id @default(cuid())
  campaignId     String
  contactId      String
  status         String   @default("INCLUDED")
  excludedReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
}

model CampaignMessage {
  id         String        @id @default(cuid())
  campaignId String
  contactId  String
  messageId  String?       @unique
  status     MessageStatus @default(QUEUED)
  errorCode  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  campaign   Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  message    Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([campaignId, contactId])
}

model Post {
  id             String        @id @default(cuid())
  workspaceId    String
  accountId      String
  title          String?
  content        String
  platform       Platform
  status         ContentStatus @default(DRAFT)
  scheduledAt    DateTime?
  publishedAt    DateTime?
  platformPostId String?
  idempotencyKey String        @unique
  approvedById   String?
  approvedAt     DateTime?
  rejectionNote  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account        SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  media          PostMedia[]
  schedule       PostSchedule?

  @@index([workspaceId, status, scheduledAt])
}

model PostMedia {
  postId       String
  mediaAssetId String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([postId, mediaAssetId])
}

model PostSchedule {
  id        String    @id @default(cuid())
  postId    String    @unique
  schedule  String
  timezone  String    @default("Asia/Ho_Chi_Minh")
  nextRunAt DateTime?
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Automation {
  id          String                @id @default(cuid())
  workspaceId String
  name        String
  description String?
  status      AutomationStatus      @default(DRAFT)
  version     Int                   @default(1)
  lastRunAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime?
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  triggers    AutomationTrigger[]
  conditions  AutomationCondition[]
  actions     AutomationAction[]

  @@index([workspaceId, status])
}

model AutomationTrigger {
  id           String     @id @default(cuid())
  automationId String
  type         String
  config       Json       @default("{}")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
}

model AutomationCondition {
  id           String     @id @default(cuid())
  automationId String
  type         String
  config       Json       @default("{}")
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
}

model AutomationAction {
  id           String     @id @default(cuid())
  automationId String
  type         String
  config       Json       @default("{}")
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
}

model Proxy {
  id                String         @id @default(cuid())
  workspaceId       String
  name              String
  type              ProxyType
  host              String
  port              Int
  encryptedUsername String?
  encryptedPassword String?
  status            ProxyStatus    @default(UNKNOWN)
  lastCheckAt       DateTime?
  latencyMs         Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accounts          AccountProxy[]

  @@unique([workspaceId, name])
}

model AccountProxy {
  accountId String
  proxyId   String
  role      String        @default("PRIMARY")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  proxy     Proxy         @relation(fields: [proxyId], references: [id], onDelete: Cascade)

  @@id([accountId, proxyId])
}

model SyncJob {
  id               String         @id @default(cuid())
  workspaceId      String
  accountId        String?
  type             String
  status           JobStatus      @default(PENDING)
  lastRunAt        DateTime?
  nextRunAt        DateTime?
  durationMs       Int?
  recordsProcessed Int            @default(0)
  recordsCreated   Int            @default(0)
  recordsUpdated   Int            @default(0)
  error            Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account          SocialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, nextRunAt])
}

model BackgroundJob {
  id          String    @id @default(cuid())
  workspaceId String
  queue       String
  externalId  String    @unique
  type        String
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  payload     Json
  result      Json?
  error       Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, queue, status])
}

model Notification {
  id          String              @id @default(cuid())
  workspaceId String
  userId      String?
  channel     NotificationChannel @default(IN_APP)
  event       String
  title       String
  body        String
  metadata    Json                @default("{}")
  readAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, readAt])
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String?
  userId      String?
  action      String
  resource    String
  resourceId  String?
  ipHash      String?
  result      String
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([resource, resourceId])
}

model WebhookEvent {
  id            String    @id @default(cuid())
  workspaceId   String
  direction     String
  eventType     String
  deliveryUrl   String?
  payload       Json
  signature     String?
  status        JobStatus @default(PENDING)
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, eventType, status])
}

model Task {
  id          String       @id @default(cuid())
  workspaceId String
  assigneeId  String?
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  status      TaskStatus   @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee    User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([workspaceId, assigneeId, status])
}
